#!/bin/sh
### BEGIN INIT INFO
# Provides: static-ip
# Required-Start: networking
# Required-Stop: 
# Default-Start: S 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Set static IP for eth0
### END INIT INFO

case "$1" in
    start)
        echo "Setting static IP for eth0..."
        /usr/local/bin/set-static-ip.sh
        ;;
    stop|restart|reload)
        ;;
    *)
        echo "Usage: $0 {start}"
        exit 1
        ;;
esac
exit 0
